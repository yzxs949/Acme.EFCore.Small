<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6;net7;net8</TargetFrameworks>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageId>Acme.EFCore.Small</PackageId>
		<Version>1.2.5.2</Version>
		<Authors>yzxs</Authors>
		<Company>yzxs</Company>
		<Product>Acme.EFCore.Small</Product>
		<Copyright>yzxs</Copyright>
		<AssemblyName>Acme.EFCore.Small</AssemblyName>
		<RootNamespace>Acme.EFCore.Small</RootNamespace>
		<Description>轻量级EFCore通用类库</Description>
		<Title>Acme.EFCore.Small</Title>
		<PackageTags>Acme;EntityFrameworkCore;EF;EFCore;EFCore.Small;yzxs;云中小生;net6;net7;net8</PackageTags>
		<PackageProjectUrl>https://www.nuget.org/packages/Acme.EFCore.Small/1.2.5.1#readme-body-tab</PackageProjectUrl>
		<PackageReleaseNotes>
			添加GetInfoNoTracking方法（技术支持联系邮箱：yzxs949@163.com）
		</PackageReleaseNotes>
